-- Every road segment the user has driven, once. Never deleted (driven roads stay on the map).
CREATE TABLE driven_segment (
    segment_id INTEGER NOT NULL PRIMARY KEY,
    first_driven_ms INTEGER NOT NULL,
    first_drive_id INTEGER NOT NULL
);

insertIfNew:
INSERT OR IGNORE INTO driven_segment(segment_id, first_driven_ms, first_drive_id) VALUES (?, ?, ?);

-- A drive imported from the cloud may be older than the local drive that first drove the segment.
updateIfEarlier:
UPDATE driven_segment SET first_driven_ms = ?, first_drive_id = ? WHERE segment_id = ? AND first_driven_ms > ?;

changes:
SELECT changes();

selectAllIds:
SELECT segment_id FROM driven_segment;

countAll:
SELECT count(*) FROM driven_segment;

selectFirstDrivenBy:
SELECT segment_id FROM driven_segment WHERE first_drive_id = ?;

selectFirstDrivenSince:
SELECT segment_id FROM driven_segment WHERE first_driven_ms >= ?;

selectAllWithFirstDrive:
SELECT segment_id, first_drive_id FROM driven_segment;

deleteAll:
DELETE FROM driven_segment;
